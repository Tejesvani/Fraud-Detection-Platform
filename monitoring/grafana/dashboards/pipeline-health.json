{
  "uid": "fraud-pipeline-health",
  "title": "Fraud Detection — Pipeline Health",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Transaction Throughput (events/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fraud_transactions_produced_total{status=\"success\"}[1m]))",
          "legendFormat": "total produced/sec",
          "refId": "A"
        },
        {
          "expr": "rate(fraud_transactions_produced_total{status=\"success\"}[1m])",
          "legendFormat": "{{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "DB Write Latency p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(fraud_db_write_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "Scoring Latency p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_scoring_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 scoring",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 4,
      "title": "Risk Score Distribution",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fraud_risk_score_distribution_bucket[5m])))",
          "legendFormat": "p50 risk score",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_risk_score_distribution_bucket[5m])))",
          "legendFormat": "p95 risk score",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1 }
      }
    },
    {
      "id": 5,
      "title": "Alerts by Severity (total)",
      "type": "piechart",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (fraud_alerts_generated_total)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "Events Persisted per Topic (rate/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (rate(fraud_events_persisted_total[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 7,
      "title": "Events Scored by Label (rate/sec)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (risk_label) (rate(fraud_events_scored_total[1m]))",
          "legendFormat": "{{risk_label}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 8,
      "title": "Consumer Lag (all services)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(fraud_risk_processor_consumer_lag)",
          "legendFormat": "Risk Processor",
          "refId": "A"
        },
        {
          "expr": "sum(fraud_alert_service_consumer_lag)",
          "legendFormat": "Alert Service",
          "refId": "B"
        },
        {
          "expr": "sum(fraud_persistence_service_consumer_lag)",
          "legendFormat": "Persistence Service",
          "refId": "C"
        },
        {
          "expr": "sum(fraud_validation_service_consumer_lag)",
          "legendFormat": "Validation Service",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }
      }
    }
  ]
}