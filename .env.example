# =============================================================================
# Fraud Detection Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it is already in .gitignore).
#
# This file is used by all Python services (producer, processor, consumers,
# frontend). The kafka-local/.env file is used by Docker Compose.
# Both files must have matching POSTGRES_* and KAFKA_PORT values.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   python producer/transaction_streamer.py
# =============================================================================

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Kafka Topics ───────────────────────────────────────────────────────────────
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_RISK_SCORES=risk_scores
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DLQ=dlq

# ── Kafka Consumer Group IDs ───────────────────────────────────────────────────
KAFKA_GROUP_RISK_PROCESSOR=risk-score-processor-group
KAFKA_GROUP_ALERT_SERVICE=alert-service-group
KAFKA_GROUP_PERSISTENCE=persistence-service-group
KAFKA_GROUP_VALIDATION=validation-service-group

# ── Schema Registry ────────────────────────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
# Set to false to fall back to plain JSON (useful if Schema Registry is not running)
SCHEMA_REGISTRY_ENABLED=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Must match the values in kafka-local/.env
POSTGRES_USER=<fraud_user>
POSTGRES_PASSWORD=<fraud_password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=<fraud_detection_db>

# ── Reconciliation ────────────────────────────────────────────────────────────
# Match rate threshold — warn/error if PostgreSQL is below this % of Kafka events
RECONCILIATION_THRESHOLD_PCT=99.9
# Skip events from the last N minutes to account for pipeline lag
RECONCILIATION_TOLERANCE_MINUTES=5

# ── dbt (Data Warehouse) ───────────────────────────────────────────────────────
# dbt uses the same POSTGRES_* variables above.
# Run manually: cd dbt && dbt run --profiles-dir .
# Run via Docker: docker compose run dbt
