# =============================================================================
# kafka-local — Docker Compose environment variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
#
# Usage (from kafka-local/):
#   docker compose up -d
# =============================================================================

# Kafka broker advertised host (use localhost for local dev)
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PORT=9092

# PostgreSQL credentials (must match root .env POSTGRES_* values)
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_password
POSTGRES_DB=fraud_detection_db
POSTGRES_PORT=5432

# Schema Registry port
SCHEMA_REGISTRY_PORT=8081

# Kafka Connect REST port (for future use)
CONNECT_REST_PORT=8084
