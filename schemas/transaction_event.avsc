{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.frauddetection.events",
  "doc": "A financial transaction event generated by the transaction streamer.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier for this transaction (UUID v4)."
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO-8601 UTC timestamp of when the transaction occurred."
    },
    {
      "name": "card_id",
      "type": "string",
      "doc": "Identifier for the card used (e.g. card1, card2)."
    },
    {
      "name": "transaction_type",
      "type": {
        "type": "enum",
        "name": "TransactionType",
        "symbols": [
          "pos_purchase",
          "online_purchase",
          "subscription",
          "high_value_retail",
          "atm_withdrawal",
          "international_purchase"
        ]
      },
      "doc": "Category of the transaction."
    },
    {
      "name": "merchant_category",
      "type": "string",
      "doc": "Merchant category code or label (e.g. grocery, e-commerce, atm)."
    },
    {
      "name": "amount",
      "type": "double",
      "doc": "Transaction amount in USD."
    },
    {
      "name": "country",
      "type": "string",
      "doc": "ISO 3166-1 alpha-2 country code where the transaction originated."
    },
    {
      "name": "device_id",
      "type": "string",
      "doc": "Identifier for the device used (e.g. device_001)."
    },
    {
      "name": "schema_version",
      "type": "int",
      "default": 1,
      "doc": "Schema version for auditability. Increment on breaking changes."
    }
  ]
}
